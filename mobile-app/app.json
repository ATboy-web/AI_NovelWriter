{
  "expo": {
    "name": "AI小说创作工坊",
    "slug": "ai-novel-writer",
    "version": "2.11.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ainovelwriter.app"
    },
    "android": {
      "package": "com.ainovelwriter.app",
      "versionCode": 21,
      "adaptiveIcon": {
        "backgroundColor": "#1e1e2e"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-build-properties"
    ],
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
