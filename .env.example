# AI_NovelWriter 生产环境变量配置
# 复制此文件为 .env 并填入实际值
#
# ⚠️ 安全警告：以下所有 your_*_here 均为占位符，
# 部署到生产环境前必须替换为强密码，否则服务会以弱口令暴露在公网。

# ===== 数据库配置 =====
DB_PASSWORD=your_secure_db_password_here

# ===== Redis 配置 =====
REDIS_PASSWORD=your_secure_redis_password_here

# ===== JWT 密钥 =====
# 必须设置为至少 32 字符的随机字符串（可用 `openssl rand -hex 32` 生成）
# 说明：服务端同时接受 SECRET_KEY 与 JWT_SECRET 两个变量名（互为别名），
#      两者其一即可；两个后端服务必须使用同一个密钥。
JWT_SECRET=your_jwt_secret_key_here_at_least_32_chars

# ===== 接口鉴权 =====
# ENABLE_AUTH=true 时，所有非公开端点（/api/v1/*）都必须携带凭据：
#   - 方式一（推荐，可长期使用）：请求头 X-API-Key: <key>
#   - 方式二：Authorization: Bearer <JWT>
# 多个 API Key 用英文逗号分隔，可写成 key:level 指定级别（默认 basic），
# 例如：API_KEYS=sk-abc123:premium,sk-def456
#
# ⚠️ 若开启 ENABLE_AUTH 却未配置 SECRET_KEY/JWT_SECRET 与 API_KEYS，
#    服务会拒绝对外提供服务（503 Auth Misconfigured），这是有意设计：
#    宁可显式失败，也不静默变成"无鉴权"。
ENABLE_AUTH=true
API_KEYS=your_backend_api_key_here

# ===== AI 服务配置 =====
AI_PROVIDER=deepseek
AI_API_KEY=your_ai_api_key_here
AI_API_BASE=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# ===== 监控配置 =====
GRAFANA_PASSWORD=your_grafana_password_here

# ===== 域名配置 =====
DOMAIN=novel.example.com

# ===== SSL 证书路径 =====
SSL_CERT_PATH=./nginx/ssl/fullchain.pem
SSL_KEY_PATH=./nginx/ssl/privkey.pem

# ===== 日志级别 =====
LOG_LEVEL=info

# ===== 备份配置 =====
BACKUP_DIR=/backup/novel
BACKUP_RETENTION_DAYS=30
